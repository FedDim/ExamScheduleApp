<Window x:Class="ExamScheduleApp.EditTeachersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование преподавателей" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="TeachersDataGrid" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                <DataGridTextColumn Header="Кабинет" Binding="{Binding Classroom, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Корпус" Binding="{Binding AcademicBuilding, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTemplateColumn Header="Действия" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить" Click="DeleteTeacher_Click" 
                                    Background="Red" Foreground="White" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить изменения" Click="SaveChanges_Click" Style="{StaticResource ModernButtonStyle}" 
                    Background="Green" Foreground="White" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Click="Close_Click" Padding="10,5" Style="{StaticResource ModernButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>