<Window x:Class="ExamScheduleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamScheduleApp"
        mc:Ignorable="d"
        Title="Генератор расписания экзаменов" 
        MinHeight="700" 
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.Resources>
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

        <Style x:Key="BaseTextStyle" TargetType="TextElement">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="36"/>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F5F5"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2196F3"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Row="0" Grid.Column="0" Header="Управление данными" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <Button Style="{StaticResource ModernButtonStyle}" Content="Добавить преподавателя" Click="AddTeacher_Click" Margin="0,5"/>
                <Button Style="{StaticResource ModernButtonStyle}" Content="Добавить дисциплину" Click="AddSubject_Click" Margin="0,5"/>
                <Button Style="{StaticResource ModernButtonStyle}" Content="Добавить группу" Click="AddGroup_Click" Margin="0,5"/>
                <Button Style="{StaticResource ModernButtonStyle}" Content="Редактировать преподавателей" Click="EditTeachers_Click" Margin="0,30,0,5"/>
                <Button Style="{StaticResource ModernButtonStyle}" Content="Редактировать дисциплины" Click="EditSubjects_Click" Margin="0,5"/>
                <Button Style="{StaticResource ModernButtonStyle}" Content="Редактировать группы" Click="EditGroups_Click" Margin="0,5"/>
                <Button Style="{StaticResource ModernButtonStyle}" Content="Удалить выбранный экзамен" Click="DeleteExam_Click" Margin="0,30,0,5" Background="Red"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="0" Grid.Column="2" Header="Создание расписания" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Дата экзамена:" Margin="0,5"
                           FontSize="14"/>
                <DatePicker x:Name="dpExamDate" Margin="0,5"/>

                <TextBlock Text="Преподаватель:" Margin="0,5" FontSize="14"/>
                <ComboBox x:Name="cbTeachers" Style ="{StaticResource ModernComboBoxStyle}" Margin="0,5"/>

                <TextBlock Text="Преподаватель 2:" Margin="0,5" FontSize="14"/>
                <ComboBox x:Name="SecondTeacherCB" Style ="{StaticResource ModernComboBoxStyle}" Margin="0,5"/>


                <TextBlock Text="Дисциплина:" Margin="0,5" FontSize="14"/>
                <ComboBox x:Name="cbSubjects" Style ="{StaticResource ModernComboBoxStyle}" Margin="0,5"/>

                <TextBlock Text="Группа:" Margin="0,5" FontSize="14"/>
                <ComboBox x:Name="GroupComboBox" Style ="{StaticResource ModernComboBoxStyle}" Margin="0,5"/>

                <TextBlock Text="Время:" Margin="0,5" FontSize="14"/>
                <ComboBox x:Name="TimeComboBox" Style="{StaticResource ModernComboBoxStyle}" Margin="0,5">

                    <ComboBoxItem Content="9:00"/>
                    <ComboBoxItem Content="11:00"/>
                    <ComboBoxItem Content="13:00"/>
                    <ComboBoxItem Content="15:00"/>
                    <ComboBoxItem Content="16:20"/>

                </ComboBox>

                <!--<TextBox x:Name="txtTime" Text="10:00" Margin="0,5"/>-->

                <TextBlock Text="Аудитория:" Margin="0,5" FontSize="14"/>
                <TextBox x:Name="txtClassroom" Margin="0,5"
                         Height="30"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Тип:" Margin="0,5" FontSize="14"/>
                <ComboBox x:Name="TypeComboBox" Style ="{StaticResource ModernComboBoxStyle}"  
                          Margin="0,5">
                    <ComboBoxItem Content="Экзамен"/>
                    <ComboBoxItem Content="Консультация"/>
                </ComboBox>

                <Button  Style="{StaticResource ModernButtonStyle}" Content="Добавить экзамен/консультацию" Click="AddExam" 
         Margin="0,10"/>
                <Button  Style="{StaticResource ModernButtonStyle}" Content="Создать файл расписания" Click="GenerateWord_Click" 
                         Background="Red"  Margin="0,10"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="ExamsDataGrid" 
                  AutoGenerateColumns="False" 
                  Margin="5"
                  Grid.Row="1"
                  Grid.ColumnSpan="3">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2C3E50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0,0,1,2"/>
                    <Setter Property="BorderBrush" Value="#34495E"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname}" Width="*"/>
                <DataGridTextColumn Header="Фамилия 2" Binding="{Binding SecondSurname}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding ExamDate}" Width="*"/>
                <DataGridTextColumn Header="Дисциплина" Binding="{Binding Subject}" Width="*"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="*"/>
                <DataGridTextColumn Header="Время" Binding="{Binding ExamTime}" Width="*"/>
                <DataGridTextColumn Header="Аудитория" Binding="{Binding Classroom}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ExamType}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="tbStatus" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                   Margin="0,10" Foreground="Blue"/>

    </Grid>
</Window>
