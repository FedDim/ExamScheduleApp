<Window x:Class="ExamScheduleApp.View.SubjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamScheduleApp.View"
        mc:Ignorable="d"
        Title="Добавить дисциплину" 
        Height="200" 
        Width="300"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Название дисциплины:"/>
        <TextBox x:Name="txtName" Margin="0,5,0,10"/>
        <TextBlock Text="Код дисциплины:"/>
        <TextBox x:Name="txtCode" Margin="0,5,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="OK_Click" Margin="0,0,5,0" Width="60"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="60"/>
        </StackPanel>
    </StackPanel>
</Window>
