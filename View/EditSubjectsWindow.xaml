<Window x:Class="ExamScheduleApp.EditSubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование дисциплин" Height="400" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="SubjectsDataGrid" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Полное название" Binding="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                <DataGridTextColumn Header="Сокр. (12)" Binding="{Binding ShortName12, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Сокр. (9)" Binding="{Binding ShortName9, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Сокр. (5)" Binding="{Binding ShortName5, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTemplateColumn Header="Действия" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить" Click="DeleteSubject_Click" 
                                    Background="Red" Foreground="White" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить изменения" Click="SaveChanges_Click" 
                    Background="Green" Foreground="White" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Click="Close_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>