<Window x:Class="ExamScheduleApp.View.DevWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamScheduleApp.View"
        mc:Ignorable="d"
        Title="Окно разработчика" 
        Height="600" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Генерация экзаменов" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Количество для генерации:" 
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="CountTextBox" 
                             Text="10" 
                             Width="100"
                             Height="25"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                    <Button x:Name="GenerateButton" 
                            Content="Сгенерировать" 
                            Click="GenerateButton_Click" 
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,10,0"
                            Width="Auto"
                            Height="45"/>
                    <Button x:Name="ClearButton" 
                            Content="Удалить сгенерированные экзамены" 
                            Click="ClearButton_Click"
                            Style="{StaticResource RedModernButtonStyle}"
                            Width="Auto"
                            Height="45"/>
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock" 
                           Text="Готов к генерации" 
                           Margin="0,5"
                           FontStyle="Italic"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Информация" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Всего сгенерировано: " 
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding Items.Count, ElementName=GeneratedExamsListBox}"
                           FontWeight="Bold"
                           Margin="5,0,0,0"
                           Foreground="Blue"/>
                <TextBlock Text=" экзаменов" 
                           FontWeight="Bold"
                           Margin="0,0,20,0"/>

                <TextBlock Text="При закрытии окна:" 
                           Margin="20,0,5,0"/>
                <TextBlock Text="Да - сохранить и передать в главное окно"
                           Margin="5,0"/>
                <TextBlock Text="Нет - удалить из базы данных"
                           Margin="5,0"/>
                <TextBlock Text="Отмена - остаться в окне"
                           Margin="5,0"/>
            </StackPanel>
        </GroupBox>

        <ListView Grid.Row="2" x:Name="GeneratedExamsListBox" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Дата" Width="80" DisplayMemberBinding="{Binding ExamDate}"/>
                    <GridViewColumn Header="Время" Width="70" DisplayMemberBinding="{Binding ExamTime}"/>
                    <GridViewColumn Header="Тип" Width="90" DisplayMemberBinding="{Binding ExamType}"/>
                    <GridViewColumn Header="Преподаватель 1" Width="150" DisplayMemberBinding="{Binding Teacher1Name}"/>
                    <GridViewColumn Header="Преподаватель 2" Width="150" DisplayMemberBinding="{Binding Teacher2Name}"/>
                    <GridViewColumn Header="Дисциплина" Width="120" DisplayMemberBinding="{Binding SubjectName}"/>
                    <GridViewColumn Header="Группа" Width="100" DisplayMemberBinding="{Binding GroupName}"/>
                    <GridViewColumn Header="Аудитория" Width="80" DisplayMemberBinding="{Binding Classroom}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>