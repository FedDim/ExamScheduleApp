<Window x:Class="ExamScheduleApp.View.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamScheduleApp.View"
        mc:Ignorable="d"
        Title="Редактирование данных" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        KeyDown="Window_KeyDown" >
    
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="EditDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить изменения" Click="SaveChanges_Click" Style="{StaticResource ModernButtonStyle}" 
                    Background="Green" Foreground="White" Padding="10,5" Margin="0,0,10,0"/>
        </StackPanel>

    </Grid>
</Window>
